// Struck: the instrument Ollin bundles so the sampler can be heard working
// without downloading anything. Generated by Scripts/make-sample-instrument.swift,
// so it is Ollin's own and carries no third party licence.
//
// Five recordings a fourth apart; each covers the notes nearest to it.
<region> sample=struck_48.wav lokey=0 hikey=50 pitch_keycenter=48
<region> sample=struck_53.wav lokey=51 hikey=55 pitch_keycenter=53
<region> sample=struck_58.wav lokey=56 hikey=60 pitch_keycenter=58
<region> sample=struck_63.wav lokey=61 hikey=65 pitch_keycenter=63
<region> sample=struck_68.wav lokey=66 hikey=127 pitch_keycenter=68
