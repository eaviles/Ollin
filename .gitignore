# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint

# macOS
.DS_Store
*.swp

# Local Claude Design handoff bundle (reference for the OllinLive UI redesign;
# kept local — not published)
/Design/

# Downloaded Core ML model weights (fetched by Scripts/fetch-models.sh, never committed)
/Models/

# Local agent tooling state (session worktrees, local settings)
.claude/

# Guide figure render cache (Scripts/guide-figures.sh); local timing + hashes
/Guide/.figure-cache.json
/Guide/.figure-baselines/

# Vale style packages fetched by `vale sync` (Scripts/prose-lint.sh); only the
# OllinGuide style is ours and committed
.vale/styles/*
!.vale/styles/OllinGuide
