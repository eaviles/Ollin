#usda 1.0
(
    doc = """Hand-authored for Ollin's 3D/Physics/Imported example: a small
             arrangement whose physics lives in the file rather than in the
             sketch. Every prim here is plain UsdPhysics, so any tool that
             reads the schema sees the same scene."""
    defaultPrim = "Yard"
    metersPerUnit = 1
    upAxis = "Y"
)

def PhysicsScene "Physics"
{
    vector3f physics:gravityDirection = (0, -1, 0)
    float physics:gravityMagnitude = 9.81
}

def Material "Rubber" (
    prepend apiSchemas = ["PhysicsMaterialAPI"]
)
{
    float physics:dynamicFriction = 0.9
    float physics:restitution = 0.6
}

def Xform "Yard"
{
    # Scenery: a collider with no rigid body over it never moves.
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 2
        double3 xformOp:translate = (0, -0.5, 0)
        double3 xformOp:scale = (9, 0.5, 9)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    # A seesaw: a plank hinged to a fixed point, so the file describes the
    # joint as well as the bodies.
    def Cube "Fulcrum" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 2
        double3 xformOp:translate = (-3, 0.25, -2)
        double3 xformOp:scale = (0.2, 0.25, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Plank" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double size = 2
        float physics:mass = 6
        double3 xformOp:translate = (-3, 0.62, -2)
        double3 xformOp:scale = (1.8, 0.06, 0.45)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def PhysicsRevoluteJoint "PlankHinge"
    {
        rel physics:body0 = </Yard/Plank>
        uniform token physics:axis = "Z"
        point3f physics:localPos0 = (0, 0, 0)
        float physics:lowerLimit = -15
        float physics:upperLimit = 15
    }

    # A weight to drop on one end of it. A block rather than a ball, since a
    # ball rolls off whatever it tips.
    def Cube "Weight" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.55
        float physics:mass = 10
        double3 xformOp:translate = (-4.1, 1.5, -2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # A stack, authored as ordinary falling bodies.
    def Cube "CrateA" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 14
        double size = 0.8
        double3 xformOp:translate = (1.2, 0.41, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "CrateB" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 14
        double size = 0.8
        double3 xformOp:translate = (1.2, 1.23, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "CrateC" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 14
        double size = 0.8
        double3 xformOp:translate = (1.25, 2.05, 0.62)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # A bouncing ball, wearing the rubber material bound above.
    def Sphere "Ball" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        rel material:binding:physics = </Rubber>
        float physics:mass = 2
        double radius = 0.3
        double3 xformOp:translate = (3.4, 3.6, 1.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # A hammer: one body wearing two colliders, which is what a rigid body
    # with several collider prims under it means.
    def Xform "Hammer" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (-1.3, 3.2, 0.9)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "Handle" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double radius = 0.07
            double height = 1.5
            uniform token axis = "Y"
        }

        def Cube "Head" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            double3 xformOp:translate = (0, 0.75, 0)
            double3 xformOp:scale = (0.42, 0.2, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    # A sign hung on a hinge fixed in space, with no post to hang it from:
    # a joint that names one body holds it to the world itself.
    def Cube "Sign" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 5
        vector3f physics:angularVelocity = (0, 0, 2.4)
        double size = 2
        double3 xformOp:translate = (3.5, 2.2, -2.4)
        double3 xformOp:scale = (0.5, 0.35, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Post" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 2
        double3 xformOp:translate = (4.25, 1.4, -2.4)
        double3 xformOp:scale = (0.06, 1.4, 0.06)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Arm" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 2
        double3 xformOp:translate = (3.85, 2.72, -2.4)
        double3 xformOp:scale = (0.45, 0.05, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def PhysicsRevoluteJoint "SignHinge"
    {
        rel physics:body0 = </Yard/Sign>
        uniform token physics:axis = "Z"
        point3f physics:localPos0 = (0, 0.4, 0)
    }

    # A capsule lying on its side: USD stands these on z unless told otherwise,
    # so this one is authored the default way on purpose.
    def Capsule "Roller" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 8
        double radius = 0.28
        double height = 1.4
        double3 xformOp:translate = (-1.2, 2.6, 2.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
