#!/bin/zsh
#
# Scripts/ollin: run a single .swift file as a sketch, from anywhere.
#
#   ollin Dots.swift                                # live window, hot-reload on save
#   ollin Dots.swift --export-gif dots.gif --seconds 4   # headless export, same flags
#   ollin new Dots.swift                            # write a starter sketch
#   ollin install                                   # put `ollin` on your PATH
#
# One .swift file is the whole sketch: no package, no target, no project. The
# file compiles against this repo's built framework and runs in the live host
# (edit + save hot-swaps it into the running window), and every export flag a
# packaged sketch takes works on the loose file too. A sketch that starts with
# `#!/usr/bin/env ollin` and is `chmod +x` runs directly: `./Dots.swift`.
#
# The script finds the repo from its own (symlink-resolved) location, so
# `ollin install` is just a symlink and the command works from any directory.
# Defaults to a release build of the host so the framework runs at full speed;
# saves stay fast because only the sketch file recompiles. Pass --debug for a
# debug host (faster first build, slower runtime).

# Captured at top level: inside a zsh function $0 becomes the function name,
# so the script's own (symlink-resolved) path must be taken here.
self="${0:A}"
repo="${self:h:h}"

usage() {
    cat <<'EOF'
usage: ollin <path/to/Sketch.swift> [flags]   run the sketch (live window)
       ollin <path/to/Sketch.swift> --export frame.png [...]
                                              headless export (--export-gif,
                                              --export-video, --export-svg, ...)
       ollin new [name.swift]                 write a starter sketch file
       ollin install [dir]                    symlink ollin onto your PATH
       ollin help                             show this help

flags: --debug (first flag) runs a debug build of the host; every other flag
is passed through to the sketch host (see Docs/Output/Export.md for the export
surface, --keep-clock for reloads that keep the clock).
EOF
}

# ollin new [name.swift]: write a starter sketch, executable, non-destructive.
cmd_new() {
    local target="${1:-Sketch.swift}"
    [[ "$target" == *.swift ]] || target="$target.swift"
    if [[ -e "$target" ]]; then
        echo "ollin: $target already exists; pick another name" >&2
        exit 1
    fi
    # Class name from the file name: strip non-identifier characters, uppercase
    # the first letter, and fall back to MySketch for names a type can't take.
    local base="${${target:t}%.swift}"
    local class="${base//[^a-zA-Z0-9_]/}"
    if [[ -z "$class" || "$class" == [0-9]* ]]; then
        class="MySketch"
    else
        class="${(U)class[1]}${class[2,-1]}"
    fi
    mkdir -p "${target:h}"
    cat > "$target" <<EOF
#!/usr/bin/env ollin
import Ollin

/// A starter sketch: a circle breathing on white. Run it, then edit and save;
/// the window hot-reloads. Delete \`+ sin(time) * 40\` and it holds still.
@main
final class $class: Sketch {
    override func setup() {
        // runs once, before the first frame
    }

    override func draw() {
        background(.white)
        noFill()
        stroke(.black)
        strokeWeight(3)
        drawCircle(width / 2, height / 2, 120 + sin(time) * 40)
    }
}
EOF
    chmod +x "$target"
    local shown="$target"
    [[ "$shown" == /* ]] || shown="./$shown"
    echo "ollin: wrote $target"
    echo "  run it:    ollin $target"
    echo "  or, since it's executable:    $shown"
}

# ollin install [dir]: symlink this script (symlink-resolved) onto the PATH.
cmd_install() {
    local dir="${1:-}"
    if [[ -z "$dir" ]]; then
        # Prefer a writable directory that's already on PATH; otherwise fall
        # back to ~/.local/bin and say what to add.
        local candidate
        for candidate in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/bin"; do
            if [[ ":$PATH:" == *":$candidate:"* && -d "$candidate" && -w "$candidate" ]]; then
                dir="$candidate"
                break
            fi
        done
        if [[ -z "$dir" ]]; then
            dir="$HOME/.local/bin"
            mkdir -p "$dir"
        fi
    fi
    if [[ ! -d "$dir" || ! -w "$dir" ]]; then
        echo "ollin: can't write to $dir" >&2
        exit 1
    fi
    ln -sf "$self" "$dir/ollin"
    echo "ollin: linked $dir/ollin -> $self"
    if [[ ":$PATH:" != *":$dir:"* ]]; then
        echo "ollin: $dir isn't on your PATH; add it, e.g."
        echo "  echo 'export PATH=\"$dir:\$PATH\"' >> ~/.zshrc"
    fi
    echo "  try it:    ollin new Dots.swift && ollin Dots.swift"
}

case "${1:-}" in
    new)
        shift; cmd_new "$@" ;;
    install)
        shift; cmd_install "$@" ;;
    help|--help|-h)
        usage ;;
    "")
        usage >&2; exit 2 ;;
    *)
        config="release"
        if [[ "$1" == "--debug" ]]; then
            config="debug"
            shift
        fi
        sketch="${1:-}"
        if [[ -z "$sketch" ]]; then
            usage >&2; exit 2
        fi
        shift
        if [[ ! -f "$sketch" ]]; then
            echo "ollin: file not found: $sketch" >&2
            exit 2
        fi
        # Absolute path: the host build runs with the repo as its package, and
        # must find the sketch regardless of the caller's working directory.
        exec swift run -c "$config" --package-path "$repo" OllinLive "${sketch:A}" "$@"
        ;;
esac
