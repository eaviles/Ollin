#compdef ollin
#
# zsh completion for the ollin command. Generated by `ollin completions`
# from the flag table in Sources/OllinReference/CommandFlags.swift, and
# gated by Scripts/check-flags.sh. Do not edit by hand.
#
# Install it by putting this file on your fpath as `_ollin`, which is
# what `ollin install` does.

_ollin() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a _ollin_commands
  _ollin_commands=(
    'new:write a starter sketch, or a project folder'
    'generate:the same, in a window'
    'phone:run the sketch on a paired iPhone or iPad'
    'check:compile a shader on this machine'\''s GPU and say what it found'
    'docs:the written reference, here in the terminal'
    'examples:the examples set - what each one shows and how to run it'
    'site:the same pages as a website, written into a folder'
    'doctor:say what this machine can run'
    'completions:print the zsh completion function'
    'install:symlink ollin, and its completions, onto your PATH'
    'help:show the command'\''s own help'
  )

  _arguments -C '1: :->command' '*:: :->argument' && return 0

  case $state in
    command)
      _alternative \
        'commands:command:{_describe -t commands "ollin command" _ollin_commands}' \
        'sketches:sketch:{_files -g "*.swift"}'
      return
      ;;
    argument)
      case $words[1] in
        new)
          _arguments \
            '--kind[what to make - a folder, an app, a screen saver, an extension]:id:' \
            '--template[which ready-made starting point]:id:' \
            '--from[start from an example, material and all]:Group/Name:' \
            '--from-shader[start from a GLSL fragment shader]:file-or-address:' \
            '--from-scene[start from a glTF or USD scene]:file:_files' \
            '--seam[what an extension package is built on]:id:' \
            '--with[extra libraries and folders to wire in]:a,b:' \
            '--canvas[the canvas size to declare]:id:' \
            '--team[the Apple Developer team an iOS app is signed under]:id:' \
            '--in[where to put it]:directory:_files -/' \
            '--remote[point the manifest at the published framework]' \
            '--framework-path[point it at a particular copy of the framework]:directory:_files -/' \
            '--list[every kind, template, seam, and extra]' \
            '--examples[every example that can be started from]' \
            '--help[what this command takes]' \
            '*:name:'
          ;;
        docs)
          _arguments \
            '--search[every place the reference says it]:text:' \
            '--list[one topic per line]' \
            '--code[only the code blocks of a page]' \
            '--width[wrap to this many columns]:n:' \
            '--plain[no color, whatever the terminal is]' \
            '--color[color, even when the output is a pipe]' \
            '--no-color[no color]' \
            '--no-pager[print straight out instead of opening a pager]' \
            '--help[what this command takes]' \
            '*:topic:'
          ;;
        examples)
          _arguments \
            '--source[print the sketch itself]' \
            '--list[one path per line]' \
            '--width[wrap to this many columns]:n:' \
            '--plain[no color, whatever the terminal is]' \
            '--no-pager[print straight out instead of opening a pager]' \
            '*:example:'
          ;;
        site)
          _arguments \
            '--domain[write the CNAME for this domain]:name:' \
            '--repository[the repository the pages link into]:owner/name:' \
            '--branch[the branch the pages link into]:name:' \
            '*:folder:_files -/'
          ;;
        check)
          _arguments \
            '--as[compile it as this shape]:generator|filter|combine:' \
            '--using[which sections of the shader library to splice in]:all|none|color,hash,noise,sdf,domain,visual:' \
            '--help[what this command takes]' \
            '*:shader:{_files -g "*.metal"}'
          ;;
        phone)
          _arguments \
            '--device[which paired phone or tablet]:name-or-id:' \
            '--devices[list the paired devices and stop]' \
            '--team[the signing team]:id:' \
            '--once[build, install, launch, and stop watching]' \
            '--fresh[start the sketch over instead of carrying its state]' \
            '--port[the local port the parameters are proxied to]:n:' \
            '--verbose[show every build line]' \
            '--help[what this command takes]' \
            '*:sketch:{_files -g "*.swift"}'
          ;;
        doctor)
          _arguments \
            '--help[what this command takes]' \
            '*: :'
          ;;
        generate|install|help)
          _files -/
          ;;
        completions)
          ;;
        *)
          _arguments \
            '--export[write one frame as a PNG]:file:_files' \
            '--export-sequence[write a numbered PNG sequence]:directory:_files -/' \
            '--export-video[write a movie]:file:_files' \
            '--export-gif[write an animated GIF]:file:_files' \
            '--export-loop[write one seamless lap of a looping sketch]:file:_files' \
            '--export-svg[write the frame as SVG]:file:_files' \
            '--export-pdf[write the frame as PDF]:file:_files' \
            '--export-exr[write the linear frame, before the tone map]:file:_files' \
            '--export-web[write a page that plays the run back in a browser]:file:_files' \
            '--export-widget[write the run a widget would show, one picture per moment]:directory:_files -/' \
            '--export-grid[write a contact sheet of seeds]:file:_files' \
            '--export-sweep[write a contact sheet sweeping one parameter]:file:_files' \
            '--export-separations[write a master per ink, for printing]:file:_files' \
            '--export-plates[write the proofed plates of a print]:file:_files' \
            '--export-usdz[write the 3D scene as USDZ]:file:_files' \
            '--export-spatial[write a spatial video]:file:_files' \
            '--export-dxf[write a DXF for a cutter]:file:_files' \
            '--export-gcode[write G-code for a pen plotter]:file:_files' \
            '--export-embroidery[write a stitch file]:file:_files' \
            '--frames[how many frames to write]:N:' \
            '--seconds[how long to write, in the sketch'\''s own seconds]:S:' \
            '--fps[frames a second - a number, a fraction, or a named rate]:F:' \
            '--skip[run this many seconds before the first written frame]:S:' \
            '--start[the number the first file of a sequence is named with]:N:' \
            '--frame[which frame to write]:N:' \
            '--render-quality[how hard the render works]:performance|default|detail:' \
            '--render-scale[draw each frame N times across and average it down]:N:' \
            '--settle[draw each written frame N times with the clock held]:N:' \
            '--slow-motion[write a file that plays N times slower than the run]:N:' \
            '--made-frames[fill the slow motion with frames built between the drawn ones]' \
            '--path-traced[render offline with a path tracer]::samples:' \
            '--pt-depth[the longest light path the tracer follows]:N:' \
            '--denoise[filter the grain out of a path-traced render]' \
            '--quality[the encoder'\''s quality]:0..1:' \
            '--bitrate[the encoder'\''s bitrate]:MBPS:' \
            '--codec[the encoder]:h264|hevc|hevcWithAlpha|proRes422|proRes4444:' \
            '--gif-width[downscale the GIF to this width]:PX:' \
            '--gif-palette[one table for the whole GIF, or one a frame]:shared|per-frame:' \
            '--size[the pixel size a widget'\''s run is drawn at]:WxH:' \
            '--exr[write a sequence in linear light instead of PNG]' \
            '--inline[write a page fragment instead of a whole file]' \
            '--no-controls[leave a page'\''s parameters at their recorded values]' \
            '--max-page-size[the most a written page may weigh]:MB:' \
            '--bench[time the frames and report, instead of drawing them]::frames:' \
            '--gpu[time the GPU too, in the benchmark]' \
            '--seed[the variation to render]:N:' \
            '--seeds[how many variations a contact sheet holds]:N:' \
            '--columns[the columns of a contact sheet]:C:' \
            '--tile[each thumbnail'\''s width on a contact sheet]:PX:' \
            '--sweep-param[the parameter a sweep sheet varies]:name:' \
            '--values[the values a sweep visits]:a,b,c:' \
            '--from[the first value of a sweep]:A:' \
            '--to[the last value of a sweep]:B:' \
            '--steps[how many values a sweep visits]:N:' \
            '--param[set one declared parameter for this run]:name=value:' \
            '--list-params[say what the sketch declares, and stop]' \
            '--cue[start at a saved cue]:name:' \
            '--cues[the cue sheet to read]:file:_files' \
            '--automation[drive the parameters from written-down curves]:file:_files' \
            '--record-take[write the run itself down, input and all]:file:_files' \
            '--replay[play a recorded take back]:file:_files' \
            '--record[keep the live run as a movie from its first frame]:file:_files' \
            '--capture-source[record the exact code the files came from]' \
            '--paper[the color of the stock]:#RRGGBB:' \
            '--inks[the ink set, by catalog name]:names:' \
            '--screen[pre-screen the masters]:dither|halftone:' \
            '--pitch[the halftone cell]:PX:' \
            '--profile[the printer profile to proof through]:name-or-path:' \
            '--intent[the rendering intent]:name:' \
            '--no-marks[write the bare canvas, with no registration marks]' \
            '--hatch[fill solid areas with hatch lines]' \
            '--cross-hatch[hatch twice, crossed]' \
            '--hatch-spacing[the gap between hatch lines]:PX:' \
            '--hatch-angle[the angle the hatching runs at]:DEG:' \
            '--fill-spacing[the spacing a fill is sewn at; 0 sews outlines]:MM:' \
            '--stitch-length[the longest stitch]:MM:' \
            '--gcode-machine[the plotter profile]:name:' \
            '--gcode-paper[the sheet the G-code is sized to]:sheet:' \
            '--gcode-margin[the border around the G-code]:MM:' \
            '--gcode-width[the physical width of the G-code]:MM:' \
            '--dxf-paper[the sheet the DXF is sized to]:sheet:' \
            '--dxf-margin[the border around the DXF]:MM:' \
            '--dxf-width[the physical width of the DXF]:MM:' \
            '--embroidery-width[the physical width of the stitching]:MM:' \
            '--embroidery-margin[the border around the stitching]:MM:' \
            '--meters-per-unit[how big one sketch unit is, in a 3D file]:U:' \
            '--interocular[the eye separation of a spatial render]:X:' \
            '--convergence[the distance the eyes converge at]:D:' \
            '--installation[give the sketch its own full-screen window]' \
            '--no-installation[ignore what the sketch declares for a long run]' \
            '--calibrate[line the projection up on its surface]' \
            '--rehearse[lay the wall out as N windows on this desk]::N:' \
            '--displays[which displays the canvas spans]:one|spanning|mirroring:' \
            '--fresh[start over instead of carrying the sketch'\''s saved state]' \
            '--debug[run a debug build of the host]' \
            '--keep-clock[carry the clock across a reload]' \
            '--no-optimize[compile the sketch plain, for debugging it]' \
            '*:file:_files'
          ;;
      esac
      ;;
  esac
}

_ollin "$@"
